  "type": "module",
  "bugs": {
    "url": "https://github.com/DevBlackk/nexora-api/issues"
  },
  "homepage": "https://github.com/DevBlackk/nexora-api#readme",
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
