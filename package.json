{
  "name": "nexora-api",
  "version": "1.0.0",
  "description": "API do **Nexora**, um gerenciador financeiro pessoal de uso exclusivo do titular. Recebe e organiza contas, transações, compromissos, dívidas e configurações de alertas, sincroniza dados com o Meu Pluggy (Open Finance) e dispara os alertas diários por e-mail.",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevBlackk/nexora-api.git"
  },
  "keywords": [],
